# Copy to .env for local development. Never commit .env.

# --- Eventor -------------------------------------------------------------
# Base URL of your Eventor instance (trailing /api is required):
#   https://eventor.orienteering.asn.au/api   (Australia)
#   https://eventor.orientering.se/api        (Sweden)
#   https://eventor.orientering.no/api        (Norway)
#   https://eventor.orienteering.sport/api    (IOF)
EVENTOR_BASE_URL=https://eventor.orienteering.asn.au/api
# Club API key, issued by your federation. Sent as the "ApiKey" header.
EVENTOR_API_KEY=
# Optional on-disk response cache (opt-in). Unset to disable.
#EVENTOR_CACHE_DIR=.eventor-cache
#EVENTOR_CACHE_TTL_SECONDS=3600

# --- Mailchimp -----------------------------------------------------------
# Marketing API key: 32 hex characters, a dash and the data centre, e.g. <32 hex chars>-us21
MAILCHIMP_API_KEY=
# Data centre prefix. Defaults to the suffix of the API key (the part after the dash).
#MAILCHIMP_SERVER_PREFIX=us21
# Audience (list) ID from Mailchimp > Audience > Settings > Audience name and defaults.
MAILCHIMP_LIST_ID=

# --- Sync behaviour ------------------------------------------------------
# Trailing window (months) for "entrant" status. Default 12.
#SYNC_WINDOW_MONTHS=12
# Up to and including this month, last year's members are still synced too. Default 3 (March).
#SYNC_PREVIOUS_YEAR_UNTIL_MONTH=3
# Where current members come from: auto | memberships | persons. Default auto
# (memberships on the Australian instance, persons elsewhere).
#SYNC_MEMBER_SOURCE=auto
# Only count paid memberships (memberships source only). Default true.
#SYNC_REQUIRE_PAID=true
# Tag names. Set SYNC_MEMBER_TAG=none to disable the aggregate "member" tag.
#SYNC_MEMBER_TAG=member
#SYNC_ENTRANT_TAG=entrant
# Also read published start lists (includes walk-ups). Default false.
#SYNC_INCLUDE_STARTS=false
# /entries never includes contact details. Members are matched by person ID; set this
# to true to also look entrants up among everyone attached to the club in Eventor
# (lapsed members included, via /persons/organisations). Default false.
#SYNC_PERSONS_CONTACT_INDEX=false
# Update FNAME/LNAME from Eventor when they differ. Default true.
#SYNC_UPDATE_NAMES=true
# Merge-field tags in your audience (max 10 characters). Only used if they exist.
#MAILCHIMP_MERGE_CLUB=CLUB
#MAILCHIMP_MERGE_MEMBERSHIP_YEAR=MEMBERYEAR
#MAILCHIMP_MERGE_EVENTOR_ID=EVENTORID
# Mobile numbers go to this merge field (PHONE exists in every audience). "none" to skip.
#MAILCHIMP_MERGE_MOBILE=PHONE
# Country code for E.164 formatting of local numbers. Defaults by instance (61 for AU);
# "none" leaves numbers exactly as typed in Eventor.
#SYNC_PHONE_COUNTRY_CODE=61
# Optional TOML file mapping events to series tags. Default config.toml if present.
#SYNC_CONFIG=config.toml
# Where to write the machine-readable run report. Default report.json.
#SYNC_REPORT_PATH=report.json
